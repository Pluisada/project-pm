OPENROUTER_API_KEY=your-openrouter-api-key-here
PORT=8000
DATABASE_URL=sqlite:///./pm.db

# Sign-up emails (SMTP, STARTTLS). Leave SMTP_HOST empty in dev to have the
# signup link printed to the backend log instead of emailed.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<16-char app password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Base URL used in emailed links: http://localhost:3000 for `next dev`,
# http://localhost:8000 for Docker.
APP_BASE_URL=http://localhost:3000
