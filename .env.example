OPENROUTER_API_KEY=your-openrouter-api-key-here

# Required. Signs every login token and email link; the app refuses to start
# if it's missing, shorter than 32 characters, or this placeholder. Generate
# your own without printing it (see docs/SECURITY.md):
#   printf 'SECRET_KEY=%s\n' "$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))')" >> .env
# Changing it logs everyone out and invalidates pending signup/reset links.
SECRET_KEY=replace-with-a-long-random-value
PORT=8000
DATABASE_URL=sqlite:///./pm.db

# Verification and password-reset emails (SMTP, STARTTLS). With SMTP_HOST empty
# nothing is sent and the link is NOT logged (by design: no link or message body
# ever reaches the logs), so sign-up and password reset cannot be completed.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<16-char app password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Base URL used in emailed links: http://localhost:3000 for `next dev`,
# http://localhost:8000 for Docker.
APP_BASE_URL=http://localhost:3000

# Public signup: comma-separated email domains allowed to self-sign-up, exact
# match (subdomains are NOT included). Unset or empty = signup is disabled.
# Admins can still create users in Manage Users. See docs/SECURITY.md section 8.
# Approved Salcomp policy: SIGNUP_ALLOWED_DOMAINS=salcomp.com
SIGNUP_ALLOWED_DOMAINS=
# Individual full addresses allowed to self-sign-up as exceptions (comma-separated).
# Each opens only that exact address, never its domain (e.g. one Gmail account).
# Approved Salcomp policy: SIGNUP_ALLOWED_EMAILS=pluisada@gmail.com (a member, not an admin).
SIGNUP_ALLOWED_EMAILS=

# Rate limiting (login, signup, forgot-password, Bid import, AI chat). The defaults
# apply when these are unset; format is "attempts/seconds". See docs/SECURITY.md.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_IP=30/300
# RATE_LIMIT_LOGIN_BACKOFF=3/5/300/900
# RATE_LIMIT_SIGNUP_IP=5/3600
# RATE_LIMIT_SIGNUP_EMAIL=3/3600
# RATE_LIMIT_FORGOT_IP=10/3600
# RATE_LIMIT_FORGOT_ACCOUNT=3/3600
# RATE_LIMIT_IMPORT_USER=10/60
# AI chat, per user (each message is a paid model call): burst and hourly ceiling.
# RATE_LIMIT_AI_USER=10/60
# RATE_LIMIT_AI_USER_HOUR=100/3600

# AI chat size limits: max characters in one message, max request body in bytes.
# AI_MAX_MESSAGE_CHARS=4000
# AI_MAX_REQUEST_BYTES=32768
# Behind a reverse proxy: its address(es)/CIDRs, so X-Forwarded-For is trusted
# from them only. Leave empty when clients connect directly.
# RATE_LIMIT_TRUSTED_PROXIES=

# Docker only (see docs/DEPLOYMENT.md). Unset = the development setup (./pm.db).
# Separate commercial database: mount its DIRECTORY and point the app at the file.
# PM_DB_HOST_PATH=/srv/pm/data
# PM_DB_CONTAINER_PATH=/data
# PM_DATABASE_URL=sqlite:////data/pm-commercial.db
# PM_PUBLIC_URL=https://pm.example.com
# With PM_DB_HOST_PATH set, compose also sets PM_REQUIRE_EXISTING_DB=1: the app then
# refuses to start unless the database file exists with a complete schema.

# CORS: comma-separated explicit origins allowed to call the API from a browser.
# Needed only when the frontend is served from a DIFFERENT origin than the API
# (development: unset defaults to http://localhost:3000 and http://127.0.0.1:3000).
# Production/Docker serves both from one origin: leave empty (same-origin only).
# "*" and paths are rejected at startup. Never invent a value; use your real URL.
# CORS_ALLOWED_ORIGINS=https://pm.example.com
# Strict-Transport-Security from the app. Enable only when the site is reachable
# over HTTPS only; usually the reverse proxy sets it (docs/SECURITY.md section 9).
# HSTS_ENABLED=true
# Docker: published address of port 8000 (default 127.0.0.1, i.e. behind a proxy).
# PM_BIND_ADDRESS=127.0.0.1
